{
	"include": ["**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
	"compilerOptions": {
		"lib": ["dom", "dom.iterable", "es2023"],
		"types": ["node", "vite/client"],
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"rootDirs": [".", "./.react-router/types"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true
	}
}
