{
	"name": "pepreviewpro-sdk",
	"private": true,
	"type": "module",
	"scripts": {
		"agents": "tsx scripts/agents.ts",
		"build": "pnpm -r --filter \"./packages/*\" run build",
		"changeset": "changeset",
		"codegen": "tsx scripts/codegen/run.ts",
		"docs:build": "typedoc",
		"docs:snippets": "tsx scripts/checkSnippets.ts",
		"examples:build": "tsx scripts/replay.ts --port 4020 -- pnpm -r --filter \"./examples/*\" run build",
		"examples:test": "tsx scripts/replay.ts --port 4020 -- pnpm -r --workspace-concurrency=1 --filter \"./examples/*\" run test",
		"format": "eslint . --fix && prettier --write .",
		"lint": "eslint . && prettier --check .",
		"pack:check": "tsx scripts/pack.ts",
		"release:publish": "tsx scripts/release.ts publish",
		"release:status": "tsx scripts/release.ts status",
		"replay": "tsx scripts/replay.ts",
		"scan:data": "tsx scripts/scanData.ts",
		"size": "size-limit",
		"smoke": "node scripts/smoke.mjs",
		"sync-fixtures": "tsx scripts/syncFixtures.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@playwright/test": "^1.64.1",
		"@size-limit/preset-small-lib": "^14.3.0",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.14.0",
		"eslint-plugin-import-x": "^4.17.1",
		"jiti": "^2.7.0",
		"jsdom": "^30.1.3",
		"next": "16.4.2",
		"prettier": "^3.9.10",
		"prettier-plugin-organize-imports": "^4.3.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"size-limit": "^14.3.0",
		"standardwebhooks": "^1.1.1",
		"tsdown": "0.23.4",
		"tsx": "^4.23.15",
		"typedoc": "^0.28.20",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "5.1.0"
	},
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": ">=22.18.0"
	},
	"size-limit": [
		{
			"name": "@pepreviewpro/browser",
			"path": "packages/browser/dist/index.js",
			"limit": "3 kB",
			"gzip": true
		},
		{
			"name": "@pepreviewpro/core",
			"path": "packages/core/dist/index.js",
			"limit": "8 kB",
			"gzip": true
		},
		{
			"name": "@pepreviewpro/react",
			"path": "packages/react/dist/index.js",
			"limit": "15 kB",
			"gzip": true,
			"ignore": [
				"react",
				"react-dom"
			]
		},
		{
			"name": "@pepreviewpro/ai",
			"path": "packages/ai/dist/index.js",
			"limit": "5 kB",
			"gzip": true,
			"ignore": [
				"ai",
				"zod",
				"@pepreviewpro/server"
			]
		}
	]
}
