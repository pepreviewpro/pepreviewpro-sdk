		{
			"name": "over the rate limit",
			"request": {
				"method": "GET",
				"query": "",
				"headers": {
					"Authorization": "Bearer {{OWNER_KEY}}"
				}
			},
			"setup": {
				"usage": {
					"user": "owner",
					"count": 20,
					"recent": true,
					"apiKeyId": "00000000-0000-4000-8000-000000000013"
				}
			},
			"response": {
				"status": 429,
				"headers": {
					"content-type": "application/json",
					"access-control-allow-origin": "*",
					"retry-after": "1"
				},
				"body": {
					"error": {
						"code": "rate_limited",
						"message": "This key sent too many requests in one second. Retry after the seconds in Retry-After.",
						"request_id": "contract-request-id"
					}
				}
			},
			"checkHeaders": [
				"content-type",
				"access-control-allow-origin",
				"retry-after"
