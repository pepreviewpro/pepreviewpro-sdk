		},
		{
			"name": "a repeated Idempotency-Key gets the first answer without running again",
			"request": {
				"method": "POST",
				"query": "",
				"headers": {
					"Authorization": "Bearer {{LINKED_PARTNER_KEY}}",
					"Content-Type": "application/json",
					"Idempotency-Key": "events-0001"
				},
				"body": {
					"events": [
						{
							"id": "evt-1",
							"type": "shown",
							"store": "example-store"
						}
					]
				}
			},
			"setup": {
				"idempotency": {
					"user": "partner",
					"endpoint": "POST /api/v1/partner-events",
					"key": "events-0001",
					"status": 200,
					"body": {
						"recorded": 1,
						"duplicates": 0,
						"skipped": 0
					}
				}
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/json",
					"access-control-allow-origin": "*"
				},
				"body": {
					"skipped": 0,
					"recorded": 1,
					"duplicates": 0
				}
			},
			"checkHeaders": [
				"content-type",
				"access-control-allow-origin"
			]
		},
		{
			"name": "an Idempotency-Key over 200 characters",
			"request": {
				"method": "POST",
				"query": "",
				"headers": {
					"Authorization": "Bearer {{LINKED_PARTNER_KEY}}",
					"Content-Type": "application/json",
					"Idempotency-Key": "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"
