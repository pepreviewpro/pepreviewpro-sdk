{
	"endpoint": "partner-events",
	"source": "Recorded from the app's handlers against the contract seed after the keyed v1 cleanup, 2026-11-03",
	"cases": [
		{
			"name": "shown stores and a click are recorded, an unknown store and a bad type are skipped",
			"request": {
				"method": "POST",
				"query": "",
				"headers": {
					"Authorization": "Bearer {{LINKED_PARTNER_KEY}}",
					"Content-Type": "application/json"
				},
				"body": {
					"events": [
						{
							"id": "evt-1",
							"type": "shown",
							"compound": "bpc-157",
							"placement": "finderStore",
							"store": "example-store"
						},
						{
							"id": "evt-2",
							"type": "shown",
							"compound": "BPC-157",
							"store": "olive-store"
						},
						{
							"id": "evt-3",
							"type": "click",
							"placement": "finderProduct",
							"store": "example-store",
							"product_ref": "88"
						},
						{
							"id": "evt-4",
							"type": "shown",
							"store": "juniper-store"
						},
						{
							"id": "evt-5",
							"type": "seen",
							"store": "example-store"
						}
					]
				}
			},
			"setup": {
				"catalog": true
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/json",
					"access-control-allow-origin": "*"
				},
				"body": {
					"recorded": 3,
					"duplicates": 0,
					"skipped": 2
				}
			},
			"checkHeaders": [
				"content-type",
				"access-control-allow-origin"
			]
		},
