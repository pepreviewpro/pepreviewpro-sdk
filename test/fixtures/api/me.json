{
	"endpoint": "me",
	"source": "Recorded from the app's handlers against the contract seed after the keyed v1 cleanup, 2026-11-03",
	"cases": [
		{
			"name": "an old-system key reads itself and this month's usage",
			"request": {
				"method": "GET",
				"query": "",
				"headers": {
					"Authorization": "Bearer {{OWNER_KEY}}"
				}
			},
			"setup": {
				"usage": {
					"user": "owner",
					"count": 3
				}
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/json",
					"access-control-allow-origin": "*"
				},
				"body": {
					"key": {
						"id": "00000000-0000-4000-8000-000000000013",
						"key_prefix": "pk_live_Ex01",
						"key_type": "public",
						"scopes": [
							"me:read",
							"store:read",
							"store:reviews",
							"store:orders"
						]
					},
					"limits": {
						"rate_per_second": 20,
						"monthly_quota": 10000,
						"used_this_month": 3,
						"remaining_this_month": 9997
					}
				}
			},
			"checkHeaders": [
				"content-type",
				"access-control-allow-origin"
			]
		},
