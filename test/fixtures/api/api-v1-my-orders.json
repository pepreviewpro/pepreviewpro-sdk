{
	"endpoint": "api-v1-my-orders",
	"source": "written from the old edge function source; replace with a recording before cutover",
	"cases": [
		{
			"name": "one order queues the store's campaign",
			"request": {
				"method": "POST",
				"query": "",
				"headers": {
					"Authorization": "Bearer {{OWNER_KEY}}",
					"Content-Type": "application/json"
				},
				"body": {
					"store_id": "example-store",
					"order": {
						"id": "1001",
						"email": "New.Buyer@Example.com",
						"name": "Garcia  Blake Reyes",
						"products": [
							{
								"id": 88,
								"name": "BPC-157"
							},
							{
								"id": "91",
								"name": "TB-500"
							}
						]
					}
				}
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/json",
					"access-control-allow-origin": "*"
				},
				"body": {
					"success": true,
					"store_id": "example-store",
					"results": [
						{
							"order_id": 1001,
							"queued": 1,
							"duplicates": 0
						}
					]
				}
			},
			"checkHeaders": [
				"content-type",
				"access-control-allow-origin"
			]
		},
		{
			"name": "a batch, where a store with no campaign is skipped",
			"request": {
				"method": "POST",
				"query": "",
				"headers": {
					"Authorization": "Bearer {{OWNER_KEY}}"
				},
				"body": {
					"store_id": "laurel-store",
					"orders": [
						{
							"id": 1,
							"email": "a@example.com"
						},
						{
							"id": 2,
							"email": "b@example.com",
							"name": null
						}
					]
				}
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/json",
					"access-control-allow-origin": "*"
				},
				"body": {
					"success": true,
					"store_id": "laurel-store",
					"results": [
						{
							"order_id": 1,
							"queued": 0,
							"duplicates": 0,
							"skipped_reason": "no_active_campaign"
						},
						{
							"order_id": 2,
							"queued": 0,
							"duplicates": 0,
							"skipped_reason": "no_active_campaign"
						}
					]
				}
			},
			"checkHeaders": [
				"content-type",
				"access-control-allow-origin"
			]
		},
