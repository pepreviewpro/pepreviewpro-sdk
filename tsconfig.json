{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023", "dom", "dom.iterable"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"paths": {
			"@pepreviewpro/core": ["./packages/core/src/index.ts"],
			"@pepreviewpro/server": ["./packages/server/src/index.ts"],
			"@pepreviewpro/browser": ["./packages/browser/src/index.ts"],
			"@pepreviewpro/react": ["./packages/react/src/index.ts"],
			"@pepreviewpro/next": ["./packages/next/src/index.ts"],
			"@pepreviewpro/next/*": ["./packages/next/src/entries/*.ts"],
			"@pepreviewpro/ai": ["./packages/ai/src/index.ts"]
		}
	},
	"include": [
		"packages/*/src/**/*.ts",
		"packages/*/src/**/*.tsx",
		"packages/*/test/**/*.ts",
		"packages/*/test/**/*.tsx",
		"packages/*/tsdown.config.ts",
		"test/**/*.ts",
		"examples/vanilla/test/**/*.ts",
		"examples/express-stripe/**/*.ts",
		"scripts/**/*.ts",
		"*.ts",
		"globals.d.ts"
	],
	"exclude": ["node_modules", "**/node_modules", "**/dist", "scripts/snippets/storeCode.d.ts"]
}
