{
	"name": "@pepreviewpro/react",
	"version": "0.1.0",
	"description": "PepReviewPro widgets, the review form, and headless hooks for React 18 and 19. Takes no key.",
	"license": "SEE LICENSE IN LICENSE",
	"author": "PepReviewPro <support@pepreviewpro.com>",
	"homepage": "https://pepreviewpro.com/help/show-reviews-with-react",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pepreviewpro/pepreviewpro-sdk.git",
		"directory": "packages/react"
	},
	"bugs": {
		"email": "support@pepreviewpro.com"
	},
	"type": "module",
